# Copy this file to .env.ps1, then replace the endpoint and API key.
# .env.ps1 is intentionally ignored by Git.

$__base = 'https://<your-endpoint>/compatible-mode/v1'
$__key = '<your-api-key>'

# Conversation and text understanding.
$env:AUTOCLIP_TEXT_BASE_URL = $__base
$env:AUTOCLIP_TEXT_MODEL = 'qwen-plus'
$env:AUTOCLIP_TEXT_API_KEY = $__key

# Representative-frame analysis.
$env:AUTOCLIP_VISION_BASE_URL = $__base
$env:AUTOCLIP_VISION_MODEL = 'qwen-vl-plus'
$env:AUTOCLIP_VISION_API_KEY = $__key

# Speech-to-text for videos without an imported SRT/VTT subtitle file.
# Qwen ASR model names must begin with "qwen" so the service uses its
# OpenAI-compatible chat-completions adapter.
$env:AUTOCLIP_ASR_BASE_URL = $__base
$env:AUTOCLIP_ASR_MODEL = 'qwen3-asr-flash-2026-02-10'
$env:AUTOCLIP_ASR_API_KEY = $__key

Remove-Variable __base, __key -ErrorAction SilentlyContinue
